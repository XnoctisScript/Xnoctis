-- Utility: Convert readable date ("Aug 08, 2025") → Unix time
local months = {
    Jan = 1, Feb = 2, Mar = 3, Apr = 4, May = 5, Jun = 6,
    Jul = 7, Aug = 8, Sep = 9, Oct = 10, Nov = 11, Dec = 12
}
local function dateToUnix(d)
    local mon, day, year = d:match("(%a+)%s+(%d+),%s*(%d+)")
    return os.time({
        year = tonumber(year),
        month = months[mon],
        day = tonumber(day),
        hour = 0,
        min = 0,
        sec = 0
    })
end

